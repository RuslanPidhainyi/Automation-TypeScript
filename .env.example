# Copy to `.env` and adjust. `.env` is git-ignored, this file is committed.

# Angular client - HTTPS with a self-signed certificate
BASE_URL=https://localhost:4200

# .NET API - note the trailing slash, it matches Client/src/environments/environment.development.ts
API_URL=https://localhost:5001/api/

# Seeded member (API/Data/UserSeedData.json - Lisa and 9 more, all with this password)
MEMBER_USER=Lisa
MEMBER_PASSWORD=Pa$$w0rd2024

# Seeded administrator (API/Data/Seed.cs) - holds both Admin and Moderator
ADMIN_USER=admin
ADMIN_PASSWORD=Admin2024

# Second account used by the sign-in health probes (specs/tests/healthCheck/auth.health.spec.ts).
# Not part of UserSeedData.json - must already exist in the target database.
TEST_USER_1=test_user_1
TEST_PASSWORD_1=testUser1#1

# How the `setup` project signs in: `ui` (default) clicks through the login
# form, `token` calls account/login directly and plants the result into
# localStorage.
# AUTH_STRATEGY=ui
